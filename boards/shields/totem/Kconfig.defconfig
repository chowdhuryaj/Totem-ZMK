# Vendored from GEIGEIGEIST/zmk-config-totem (MIT). Changed: keyboard name.

if SHIELD_TOTEM_LEFT

config ZMK_KEYBOARD_NAME
    default "Totem"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_TOTEM_LEFT || SHIELD_TOTEM_RIGHT

config ZMK_SPLIT
    default y

endif

# Prospector dongle (Seeed XIAO nRF52840, zmkfirmware dongle guide,
# hardware-integration/dongle.mdx @ the pinned ZMK): central for BOTH halves
# (those build as peripherals, see build.yaml). No keys of its own.
if SHIELD_TOTEM_DONGLE

config ZMK_KEYBOARD_NAME
    default "Totem"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Left + right halves.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Live links: 2 halves + the Endgame (zmk-ble-mouse-host) + the one active
# host (ZMK never holds two hosts at once), so 4; each extra conn costs RAM
# next to LVGL. Bonds: ZMK derives its profile count as BT_MAX_PAIRED -
# PERIPHERALS (app/include/zmk/ble.h), so the mouse bond leaves 6 profile
# slots in the count; the keymap only selects 0-3, so a profile never evicts
# a bond. BT_ATT_TX_COUNT needs no line here: ZMK already defaults it to 10
# on a split central (app/src/split/bluetooth/Kconfig), above the mouse
# module's 8.
config BT_MAX_CONN
    default 4

config BT_MAX_PAIRED
    default 8

# The Prospector's battery widget needs peripheral battery fetching; its
# shield defaults it on and totem.conf sets it too, so nothing to add here.

endif

# Vendored from GEIGEIGEIST/zmk-config-totem (MIT). Changed: keyboard name.

if SHIELD_TOTEM_LEFT

config ZMK_KEYBOARD_NAME
    default "Totem"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_TOTEM_LEFT || SHIELD_TOTEM_RIGHT

config ZMK_SPLIT
    default y

# Deep sleep after ZMK_IDLE_SLEEP_TIMEOUT (default 15 min idle): the halves
# run on battery and otherwise stay connected all night. A key press wakes
# the half (kscan0 is a wakeup-source) and it reconnects to the dongle in
# ~1-2 s; that first key can be lost. Never on the dongle: it has no keys
# to wake it.
config ZMK_SLEEP
    default y

endif

# Prospector dongle (Seeed XIAO nRF52840, zmkfirmware dongle guide,
# hardware-integration/dongle.mdx @ the pinned ZMK): central for BOTH halves
# (those build as peripherals, see build.yaml). No keys of its own.
if SHIELD_TOTEM_DONGLE

config ZMK_KEYBOARD_NAME
    default "Totem"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Left + right halves.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Live links: 2 halves + the Endgame (zmk-ble-mouse-host) + hosts + one
# phone (phone remote, docs/phone-remote.md). ZMK keeps the old host
# connected when switching profiles (ble.c zmk_ble_prof_select), and
# connectable advertising needs a free conn object, so 6 (the left central's
# old budget) left room for two hosts plus an Endgame reconnect; +1 for the
# phone makes 7. Drop to 4 (+1) only if RAM overflows (then switching to a
# second host needs &bt BT_DISC first). Bonds: ZMK derives its profile count
# as BT_MAX_PAIRED - PERIPHERALS (app/include/zmk/ble.h). 8 gave 6 profiles,
# 5 usable with the Endgame bonded; +2 for two bonded phones makes 10, i.e.
# 8 profiles: the phones pair into the highest free ones (7, 6) and the
# keymap's BT_SEL 0-3 stay for hosts. BT_ATT_TX_COUNT needs no line here: ZMK
# already defaults it to 10 on a split central
# (app/src/split/bluetooth/Kconfig), above the mouse module's 8.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 10

# The phone's 15 ms link (remote.c PHONE_CONN_PARAM) is only requested when
# this timer fires; Zephyr's 5 s left the phone on its own 30 ms for the
# first 5 s of every reconnect. Below the spec's "should not within 5 s";
# BLE hosts get ZMK's preferred parameters 4 s sooner too. Peripheral links
# only: the halves and the Endgame are central links.
config BT_CONN_PARAM_UPDATE_TIMEOUT
    default 1000

# Phone remote (repo-root Kconfig, docs/phone-remote.md): dongle only.
config TOTEM_PHONE_REMOTE
    default y

# GAP Device Name is writable by any bonded peer by default (Zephyr, since
# ZMK turns on BT_DEVICE_NAME_DYNAMIC), and the name is saved: a paired phone
# or host could rename the dongle. ZMK sets its own name locally.
config BT_DEVICE_NAME_GATT_WRITABLE
    default n

# No USB serial console on the dongle (totem_dongle.overlay disables the
# board's CDC-ACM node): the host sees ZMK's HID interface only.
config BOARD_SERIAL_BACKEND_CDC_ACM
    default n

# The Prospector's battery widget needs peripheral battery fetching; its
# shield defaults it on and totem.conf sets it too, so nothing to add here.

endif

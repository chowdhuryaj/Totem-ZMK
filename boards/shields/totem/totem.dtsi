 * SPDX-License-Identifier: MIT
 *
 * Vendored from GEIGEIGEIST/zmk-config-totem @ 8325195 (MIT). Changes for
 * ZMK main (Zephyr 4.1) + ZMK Studio: dropped the deprecated `label`
 * property, added `wakeup-source`, and added a physical layout (Studio
 * requires `zmk,physical-layout`; it carries the matrix transform, so the
 * old `zmk,matrix_transform` chosen is gone).
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &totem_physical_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
//             | SW01  | SW02  | SW03  | SW04  | SW05  |  | SW05  | SW04  | SW03  | SW02  | SW01  |
//             | SW06  | SW07  | SW08  | SW09  | SW10  |  | SW10  | SW09  | SW08  | SW07  | SW06  |
//      | SW16 | SW11  | SW12  | SW13  | SW14  | SW15  |  | SW15  | SW14  | SW13  | SW12  | SW11  | SW16  |
//                             | SW17  | SW18  | SW19  |  | SW19  | SW18  | SW17  |
        map = <
                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(3,0) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(3,9)
                                RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    /* Studio geometry, same key order as the transform map (38 keys).
     * Approximate: column stagger and thumb splay eyeballed from the TOTEM
     * layout image, not measured. Wrong geometry only changes how Studio
     * draws the board; bindings are unaffected. */
    totem_physical_layout: totem_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "TOTEM";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  100   70       0     0     0>
            , <&key_physical_attrs 100 100  200   25       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   20       0     0     0>
            , <&key_physical_attrs 100 100  500   35       0     0     0>
            , <&key_physical_attrs 100 100  850   35       0     0     0>
            , <&key_physical_attrs 100 100  950   20       0     0     0>
            , <&key_physical_attrs 100 100 1050    0       0     0     0>
            , <&key_physical_attrs 100 100 1150   25       0     0     0>
            , <&key_physical_attrs 100 100 1250   70       0     0     0>
            , <&key_physical_attrs 100 100  100  170       0     0     0>
            , <&key_physical_attrs 100 100  200  125       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  120       0     0     0>
            , <&key_physical_attrs 100 100  500  135       0     0     0>
            , <&key_physical_attrs 100 100  850  135       0     0     0>
            , <&key_physical_attrs 100 100  950  120       0     0     0>
            , <&key_physical_attrs 100 100 1050  100       0     0     0>
            , <&key_physical_attrs 100 100 1150  125       0     0     0>
            , <&key_physical_attrs 100 100 1250  170       0     0     0>
            , <&key_physical_attrs 100 100    0  300       0     0     0>
            , <&key_physical_attrs 100 100  100  270       0     0     0>
            , <&key_physical_attrs 100 100  200  225       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  220       0     0     0>
            , <&key_physical_attrs 100 100  500  235       0     0     0>
            , <&key_physical_attrs 100 100  850  235       0     0     0>
            , <&key_physical_attrs 100 100  950  220       0     0     0>
            , <&key_physical_attrs 100 100 1050  200       0     0     0>
            , <&key_physical_attrs 100 100 1150  225       0     0     0>
            , <&key_physical_attrs 100 100 1250  270       0     0     0>
            , <&key_physical_attrs 100 100 1350  300       0     0     0>
            , <&key_physical_attrs 100 100  330  335       0     0     0>
            , <&key_physical_attrs 100 100  440  350    1000   490   400>
            , <&key_physical_attrs 100 100  550  380    2000   600   430>
            , <&key_physical_attrs 100 100  800  380 (-2000)   850   430>
            , <&key_physical_attrs 100 100  910  350 (-1000)   960   400>
            , <&key_physical_attrs 100 100 1020  335       0     0     0>
            ;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

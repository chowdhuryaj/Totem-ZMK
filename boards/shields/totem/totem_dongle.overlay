 *
 * Prospector dongle: no keys, so the real matrix scan is swapped for ZMK's
 * mock kscan (dongle guide). Reuses totem.dtsi so the matrix transform and
 * Studio physical layout stay identical to the halves (the halves send
 * positions already transformed by their own col-offset).
 */

#include "totem.dtsi"

/* totem.dtsi's kscan0 has no col-gpios here (the pins belong to the
 * display), so it must not stay in the tree. */
/delete-node/ &kscan0;

/ {
    chosen {
        zmk,kscan = &mock_kscan;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /* Endgame trackball over BLE (AJ's zmk-ble-mouse-host fork). Only the
     * central runs it, so the node and behaviors live here, not in the shared
     * keymap. */
    mouse_host: mouse_host {
        compatible = "zmk,ble-mouse-host";
        /* Pairing mode picks the first Endgame by name, not any mouse. */
        pair-name-prefix = "Endgame";
    };

    /* Plain forward into the pointing pipeline. No layer-conditional
     * processors yet (speed layers etc. are AJ's call). */
    mouse_host_listener {
        compatible = "zmk,input-listener";
        device = <&mouse_host>;
    };

    behaviors {
        mouse_pair: mouse_pair {
            compatible = "zmk,behavior-mouse-host-pair";
            #binding-cells = <0>;
        };

        mouse_unpair: mouse_unpair {
            compatible = "zmk,behavior-mouse-host-unpair";
            #binding-cells = <0>;
        };
    };

    /* The module's behaviors carry no Studio metadata at the pinned ZMK (same
     * gap as &mmv/&msc), so macros make them assignable from Studio /
     * Totem-Flask. Not bound in totem.keymap: every thumb on Navigation is
     * load-bearing and AJ's live keymap lives in Studio anyway. Pair forgets
     * the old bond first, so Unpair is only for "stop reconnecting". */
    macros {
        endgame_pair: endgame_pair {
            compatible = "zmk,behavior-macro";
            display-name = "Pair Endgame";
            #binding-cells = <0>;
            bindings = <&mouse_pair>;
        };

        endgame_unpair: endgame_unpair {
            compatible = "zmk,behavior-macro";
            display-name = "Unpair Endgame";
            #binding-cells = <0>;
            bindings = <&mouse_unpair>;
        };
    };
};
